@page "/gestion"
@rendermode InteractiveServer
@using Panaderia_Proyecto.Models
@using Panaderia_Proyecto.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db

<h2>Gestión de Clientes</h2>

<div style="border:1px solid #ccc; padding:1rem; margin-bottom:1rem; border-radius:8px;">
    <h4>@(clienteEditando.Id == 0 ? "Nuevo Cliente" : "Editar Cliente")</h4>

    <div>
        <label>Nombre *</label>
        <input type="text" @bind="clienteEditando.Nombre" placeholder="Nombre completo" />
    </div>
    <div>
        <label>Teléfono *</label>
        @* type="tel" solo permite números y formatos de teléfono *@
        <input type="tel" @bind="clienteEditando.Telefono" placeholder="10 dígitos"
               maxlength="10" pattern="[0-9]{10}" />
    </div>
    <div>
        <label>Email *</label>
        @* type="email" valida automáticamente el formato de correo *@
        <input type="email" @bind="clienteEditando.Email" placeholder="correo@ejemplo.com" />
    </div>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <p style="color:red;">@mensajeError</p>
    }
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <p style="color:green;">@mensajeExito</p>
    }

    <br />
    <button @onclick="GuardarCliente">
        @(clienteEditando.Id == 0 ? "Agregar" : "Guardar cambios")
    </button>
    @if (clienteEditando.Id != 0)
    {
        <button @onclick="CancelarEdicion">Cancelar</button>
    }
</div>

@if (clientes == null)
{
    <p>Cargando clientes...</p>
}
else if (!clientes.Any())
{
    <p>No hay clientes registrados aún.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Email</th>
                <th>Fecha Registro</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in clientes)
            {
                <tr>
                    <td>@cliente.Nombre</td>
                    <td>@cliente.Telefono</td>
                    <td>@cliente.Email</td>
                    <td>@cliente.FechaRegistro.ToShortDateString()</td>
                    <td>
                        <button @onclick="() => EditarCliente(cliente)">Editar</button>
                        <button @onclick="() => ConfirmarEliminar(cliente.Id)"
                                style="color:red;">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (idAEliminar != 0)
{
    <div style="border:2px solid red; padding:1rem; margin-top:1rem; border-radius:8px;">
        <p>¿Estás seguro de que quieres eliminar este cliente?</p>
        <button @onclick="EliminarCliente" style="color:red;">Sí, eliminar</button>
        <button @onclick="() => idAEliminar = 0">No, cancelar</button>
    </div>
}

@code {
    private List<Cliente>? clientes;
    private Cliente clienteEditando = new();
    private int idAEliminar = 0;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        clientes = await Db.Clientes.AsNoTracking().ToListAsync();
    }

    private async Task GuardarCliente()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        // Validación — todos los campos son obligatorios
        if (string.IsNullOrWhiteSpace(clienteEditando.Nombre))
        {
            mensajeError = "El nombre es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(clienteEditando.Telefono))
        {
            mensajeError = "El teléfono es obligatorio.";
            return;
        }

        // Validación — solo números en teléfono
        if (!clienteEditando.Telefono.All(char.IsDigit))
        {
            mensajeError = "El teléfono solo puede contener números.";
            return;
        }

        // Validación — exactamente 10 dígitos
        if (clienteEditando.Telefono.Length != 10)
        {
            mensajeError = "El teléfono debe tener exactamente 10 dígitos.";
            return;
        }

        if (string.IsNullOrWhiteSpace(clienteEditando.Email))
        {
            mensajeError = "El email es obligatorio.";
            return;
        }

        // Validación — formato de email válido
        if (!clienteEditando.Email.Contains("@") || !clienteEditando.Email.Contains("."))
        {
            mensajeError = "El email no tiene un formato válido.";
            return;
        }

        if (clienteEditando.Id == 0)
        {
            Db.Clientes.Add(clienteEditando);
            mensajeExito = "Cliente agregado correctamente.";
        }
        else
        {
            var original = await Db.Clientes.FindAsync(clienteEditando.Id);
            if (original != null)
            {
                original.Nombre = clienteEditando.Nombre;
                original.Telefono = clienteEditando.Telefono;
                original.Email = clienteEditando.Email;
            }
            mensajeExito = "Cliente actualizado correctamente.";
        }

        await Db.SaveChangesAsync();
        clienteEditando = new();
        await CargarClientes();
    }

    private void EditarCliente(Cliente cliente)
    {
        clienteEditando = new Cliente
        {
            Id = cliente.Id,
            Nombre = cliente.Nombre,
            Telefono = cliente.Telefono,
            Email = cliente.Email,
            FechaRegistro = cliente.FechaRegistro
        };
    }

    private void CancelarEdicion()
    {
        clienteEditando = new();
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
    }

    private void ConfirmarEliminar(int id)
    {
        idAEliminar = id;
    }

    private async Task EliminarCliente()
    {
        var cliente = await Db.Clientes.FindAsync(idAEliminar);
        if (cliente != null)
        {
            Db.Clientes.Remove(cliente);
            await Db.SaveChangesAsync();
        }
        idAEliminar = 0;
        await CargarClientes();
    }
}